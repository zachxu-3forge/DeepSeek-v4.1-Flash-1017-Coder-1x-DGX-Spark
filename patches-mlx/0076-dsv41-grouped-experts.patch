+// Grouped 2-bit experts: gather each selected expert's activation rows, one M=count GEMV,
+// then scatter back. The grouped path is used only for rows > 1.
+extern "C" __global__ void __launch_bounds__(256) tf_affine_gather_rows(
+    const __nv_bfloat16* __restrict__ x, const float* __restrict__ xs,
+    const int* __restrict__ members, const int* __restrict__ ucount,
+    int slots, int k, int x_slots, int maxm, __nv_bfloat16* __restrict__ xg,
+    float* __restrict__ xsg, int* __restrict__ slotmap) {
+    const int e = blockIdx.x;
+    if (e >= *ucount) return;
+    int count = 0;
+    while (count < maxm && members[e * maxm + count] >= 0) ++count;
+    for (int r = 0; r < count; ++r) {
+        const int m = members[e * maxm + r];
+        const int i = m / 32, slot = m - i * 32;
+        const int src = x_slots ? i * slots + slot : i;
+        const __nv_bfloat16* srcx = x + (size_t)src * k;
+        __nv_bfloat16* dstx = xg + ((size_t)e * maxm + r) * k;
+        for (int t = threadIdx.x; t < k; t += blockDim.x) dstx[t] = srcx[t];
+        for (int t = threadIdx.x; t < k / 64; t += blockDim.x)
+            xsg[((size_t)e * maxm + r) * (k / 64) + t] = xs[(size_t)src * (k / 64) + t];
+        if (threadIdx.x == 0) slotmap[e * maxm + r] = src;
+    }
+    for (int r = count; r < maxm; ++r) if (threadIdx.x == 0) slotmap[e * maxm + r] = -1;
+}
+
+extern "C" __global__ void __launch_bounds__(128) tf_affine2_group_gemv(
+    const __nv_bfloat16* __restrict__ xg, const float* __restrict__ xs,
+    const uint32_t* __restrict__ w, const __nv_bfloat16* __restrict__ scales,
+    const __nv_bfloat16* __restrict__ biases, const int* __restrict__ uids,
+    const int* __restrict__ ucount, const int* __restrict__ members, int maxm,
+    int k, int n, long long expert_words, long long expert_scales,
+    __nv_bfloat16* __restrict__ og) {
+    const int e = blockIdx.y;
+    if (e >= *ucount) return;
+    int count = 0;
+    while (count < maxm && members[e * maxm + count] >= 0) ++count;
+    if (count == 0) return;
+    const int ex = uids[e];
+    tf_affine8::Part P;
+    P.w = w + (size_t)ex * expert_words;
+    P.scales = scales + (size_t)ex * expert_scales;
+    P.biases = biases + (size_t)ex * expert_scales;
+    P.out = og + (size_t)e * maxm * n;
+    P.n = n; P.npad = n; P.sk = 1; P.tiles = (n + 63) / 64;
+    tf_affine8::gemv<64, 64, 6, 2>(xg + (size_t)e * maxm * k, xs + (size_t)e * maxm * (k / 64), P, count, k, k);
+}
+
+extern "C" __global__ void __launch_bounds__(256) tf_affine_group_scatter(
+    const __nv_bfloat16* __restrict__ og, const int* __restrict__ slotmap,
+    const int* __restrict__ ucount, int maxm, int n, __nv_bfloat16* __restrict__ out) {
+    const int e = blockIdx.x;
+    if (e >= *ucount) return;
+    for (int r = 0; r < maxm; ++r) {
+        const int dst = slotmap[e * maxm + r];
+        if (dst < 0) break;
+        const __nv_bfloat16* src = og + ((size_t)e * maxm + r) * n;
+        __nv_bfloat16* d = out + (size_t)dst * n;
+        for (int t = threadIdx.x; t < n; t += blockDim.x) d[t] = src[t];
+    }
+}
