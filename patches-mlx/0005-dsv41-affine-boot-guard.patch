+/// Check `base.weight`, `base.scales`, and `base.biases` headers without reading payload bytes.
+pub fn checkModule(pack: *const Pack, base: []const u8, layout: affine.Layout) !void {
+    var buf: [256]u8 = undefined;
+    const weight = try pack.need(try std.fmt.bufPrint(&buf, "{s}.weight", .{base}));
+    const scales = try pack.need(try std.fmt.bufPrint(&buf, "{s}.scales", .{base}));
+    const biases = try pack.need(try std.fmt.bufPrint(&buf, "{s}.biases", .{base}));
+    if (weight.dtype != .u32 or scales.dtype == .u32 or biases.dtype == .u32) return error.UnexpectedTensor;
+    try layout.checkShape(weight.dims(), scales.dims(), biases.dims());
+}
