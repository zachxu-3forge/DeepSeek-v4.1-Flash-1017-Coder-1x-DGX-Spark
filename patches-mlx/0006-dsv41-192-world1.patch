+test "a 192-expert layer plans three expert stacks without loading headers" {
+    const a = std.testing.allocator;
+    var cfg = @import("config.zig").tiny();
+    cfg.layers = 1;
+    cfg.mtp_layers = 0;
+    cfg.experts = 192;
+    cfg.q_lora = 64;
+    cfg.compress_ratios = @import("config.zig").Ids.of(&.{0});
+    cfg.kv_sources = .{};
+    cfg.index_sources = .{};
+    cfg.engram_layers = .{};
+    cfg.engram_rows = @import("config.zig").List(u64, 8).of(&.{});
+    const json =
+        \\{"quantization":{"quant_method":"affine","bits":4,"group_size":64,"dense_by_default":true,
+        \\"layers.0.ffn.experts.w1":{"bits":2,"group_size":64},
+        \\"layers.0.ffn.experts.w2":{"bits":2,"group_size":64},
+        \\"layers.0.ffn.experts.w3":{"bits":2,"group_size":64}}}
+    ;
+    var formats = try affine.Formats.init(a, json);
+    defer formats.deinit();
+    var p = Pack.init(a);
+    defer p.deinit();
+    var plan = try build(a, &cfg, &p, &formats);
+    defer plan.deinit();
+    try std.testing.expectEqual(@as(usize, 3), plan.layers[0].modules.len);
+    for (plan.layers[0].modules) |m| {
+        try std.testing.expectEqual(Kind.expert, m.kind);
+        try std.testing.expectEqual(@as(u32, 256), m.layout.n);
+        try std.testing.expectEqual(@as(u32, 256), m.layout.k);
+    }
+}
