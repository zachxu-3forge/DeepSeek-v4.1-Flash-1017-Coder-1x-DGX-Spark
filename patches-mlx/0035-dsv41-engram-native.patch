diff --git a/zig/src/families/deepseek_v41/engram_rows.zig b/zig/src/families/deepseek_v41/engram_rows.zig
index 5f721c0..e596580 100644
--- a/zig/src/families/deepseek_v41/engram_rows.zig
+++ b/zig/src/families/deepseek_v41/engram_rows.zig
@@ -5,11 +5,61 @@ const std = @import("std");
 pub const magic: u64 = 0x31344E4531565344; // "DSV41EN1"; file `<dir>/engram-l<layer>-r<rank>of<world>.bin`
 pub const header_bytes: u64 = 4096; // 6 little-endian u64: magic, layer, lo, hi, total rows, row bytes
 pub const sector: u64 = 512;
-pub const row_bytes: u64 = 264; // 256 e4m3 values and 8 UE8M0 scales (one a 32)
+pub const fp8_row_bytes: u64 = 264; // 256 e4m3 values and 8 UE8M0 scales (one a 32)
+pub const native_row_bytes: u64 = 160; // 32 U32 affine-4 words, 8 BF16 scales, 8 BF16 biases
+pub const row_bytes: u64 = fp8_row_bytes; // legacy default; readers use Header.row_bytes
 pub const values = 256;
 pub const merge_gap: u64 = 4096; // holes up to this merged into one extent
 pub const page = 4096;
 
+pub const RowFormat = enum { fp8, affine4 };
+
+pub fn formatOf(rb: u64) ?RowFormat {
+    return switch (rb) {
+        fp8_row_bytes => .fp8,
+        native_row_bytes => .affine4,
+        else => null,
+    };
+}
+
+/// A bfloat16 bit pattern as float32 (the exact value the row stores).
+pub fn fromBf16(bits: u16) f32 {
+    return @bitCast(@as(u32, bits) << 16);
+}
+
+/// One shard row's first `dim` values as bf16 bits.
+///
+/// FP8 rows (264 bytes) decode through `lut` when given, else compute `e4m3 x 2^(scale-127)`.
+/// Native rows (160 bytes) hold 32 U32 words of affine-4 codes (low nibble first), then 8 BF16
+/// scales and 8 BF16 biases, one each per 32 values: `code * scale + bias`.
+pub fn decodeRow(rec: []const u8, dim: usize, lut: ?*const [65536]u16, out: []u16) !void {
+    if (dim == 0 or dim > values or dim % 32 != 0 or out.len != dim) return error.BadEngramRow;
+    switch (formatOf(rec.len) orelse return error.BadEngramRow) {
+        .fp8 => {
+            if (rec.len < fp8_row_bytes) return error.BadEngramRow;
+            for (out, 0..) |*v, j| {
+                const scale_code = rec[values + j / 32];
+                v.* = if (lut) |t| t[@as(usize, scale_code) << 8 | rec[j]] else bf16(e4m3(rec[j]) * scale(scale_code));
+            }
+        },
+        .affine4 => {
+            if (rec.len < native_row_bytes) return error.BadEngramRow;
+            const scales_at: usize = 32 * 4; // 32 U32 words of 4-bit codes
+            const biases_at: usize = scales_at + 8 * 2;
+            for (0..dim / 32) |g| {
+                const s = fromBf16(std.mem.readInt(u16, rec[scales_at + 2 * g ..][0..2], .little));
+                const b = fromBf16(std.mem.readInt(u16, rec[biases_at + 2 * g ..][0..2], .little));
+                for (0..32) |u| {
+                    const j = g * 32 + u;
+                    const word = std.mem.readInt(u32, rec[4 * (j / 8) ..][0..4], .little);
+                    const q: u32 = (word >> @intCast((j % 8) * 4)) & 0xF;
+                    out[j] = bf16(@as(f32, @floatFromInt(q)) * s + b);
+                }
+            }
+        },
+    }
+}
+
 pub const Header = struct {
     layer: u64,
     lo: u64,
@@ -23,7 +73,7 @@ pub const Header = struct {
         for (&w, 0..) |*x, i| x.* = std.mem.readInt(u64, b[8 * i ..][0..8], .little);
         if (w[0] != magic) return error.NotEngramShard;
         const h: Header = .{ .layer = w[1], .lo = w[2], .hi = w[3], .total = w[4], .row_bytes = w[5] };
-        if (h.row_bytes != row_bytes or h.hi < h.lo or h.hi > h.total) return error.BadEngramShard;
+        if (formatOf(h.row_bytes) == null or h.hi < h.lo or h.hi > h.total) return error.BadEngramShard;
         const payload = std.math.mul(u64, h.hi - h.lo, h.row_bytes) catch return error.BadEngramShard;
         const expected = std.math.add(u64, header_bytes, payload) catch return error.BadEngramShard;
         if (size != expected) return error.BadEngramShard;
@@ -110,3 +160,74 @@ test "Linux row storage releases tables if LUT allocation fails" {
     };
     try std.testing.checkAllAllocationFailures(std.testing.allocator, check.run, .{});
 }
+
+fn putNativeRow(row: []u8, seed: u64) void {
+    @memset(row, 0);
+    for (0..32) |w| {
+        var word: u32 = 0;
+        for (0..8) |k| {
+            const q: u32 = @intCast((w * 8 + k + seed) % 16);
+            word |= q << @intCast(k * 4);
+        }
+        std.mem.writeInt(u32, row[4 * w ..][0..4], word, .little);
+    }
+    for (0..8) |g| {
+        std.mem.writeInt(u16, row[128 + 2 * g ..][0..2], bf16(1.0 + @as(f32, @floatFromInt(g)) * 0.5), .little);
+        std.mem.writeInt(u16, row[144 + 2 * g ..][0..2], bf16(-0.5 + @as(f32, @floatFromInt(g)) * 0.125), .little);
+    }
+}
+
+test "a native affine-4 row decodes code * scale + bias" {
+    var rec: [native_row_bytes]u8 = undefined;
+    putNativeRow(&rec, 3);
+    var got: [values]u16 = undefined;
+    try decodeRow(&rec, values, null, &got);
+    for (got, 0..) |v, j| {
+        const g = j / 32;
+        const s = 1.0 + @as(f32, @floatFromInt(g)) * 0.5;
+        const b = -0.5 + @as(f32, @floatFromInt(g)) * 0.125;
+        const q: f32 = @floatFromInt((j + 3) % 16);
+        try std.testing.expectEqual(bf16(q * s + b), v);
+    }
+    // dim is a prefix: the first two groups only
+    var short: [64]u16 = undefined;
+    try decodeRow(&rec, 64, null, &short);
+    try std.testing.expectEqualSlices(u16, got[0..64], &short);
+}
+
+test "an FP8 row decodes through the LUT and directly" {
+    var rec: [fp8_row_bytes]u8 = undefined;
+    @memset(&rec, 0x80);
+    rec[0] = 0x00;
+    rec[1] = 0x38;
+    rec[2] = 0x40;
+    rec[3] = 0x7E;
+    @memset(rec[values..], 127);
+    var lut: [65536]u16 = undefined;
+    fillTable(&lut);
+    var a: [values]u16 = undefined;
+    var b: [values]u16 = undefined;
+    try decodeRow(&rec, values, &lut, &a);
+    try decodeRow(&rec, values, null, &b);
+    try std.testing.expectEqualSlices(u16, &a, &b);
+    try std.testing.expectEqual(@as(u16, 0x0000), a[0]); // 0
+    try std.testing.expectEqual(@as(u16, 0x3f80), a[1]); // 1
+    try std.testing.expectEqual(@as(u16, 0x4000), a[2]); // 2
+    try std.testing.expectEqual(@as(u16, 0x43e0), a[3]); // 448
+}
+
+test "the shard header admits both row formats and nothing else" {
+    var b: [48]u8 = @splat(0);
+    const write = struct {
+        fn h(buf: *[48]u8, rows: u64, rb: u64) void {
+            for ([_]u64{ magic, 1, 0, rows, rows, rb }, 0..) |v, i| std.mem.writeInt(u64, buf[8 * i ..][0..8], v, .little);
+        }
+    }.h;
+    write(&b, 4, native_row_bytes);
+    const h = try Header.parse(&b, header_bytes + 4 * native_row_bytes);
+    try std.testing.expectEqual(RowFormat.affine4, formatOf(h.row_bytes).?);
+    write(&b, 4, fp8_row_bytes);
+    _ = try Header.parse(&b, header_bytes + 4 * fp8_row_bytes);
+    write(&b, 4, 161);
+    try std.testing.expectError(error.BadEngramShard, Header.parse(&b, header_bytes + 4 * 161));
+}
