diff --git a/zig/src/families/deepseek_v41/engram_native_test.zig b/zig/src/families/deepseek_v41/engram_native_test.zig
new file mode 100644
index 0000000..76deb6d
--- /dev/null
+++ b/zig/src/families/deepseek_v41/engram_native_test.zig
@@ -0,0 +1,68 @@
+//! Native affine-4 Engram rows (160 B): decoding beside FP8 rows and a shard read through `Rows`.
+
+const std = @import("std");
+const testing = std.testing;
+const er = @import("engram_rows.zig");
+
+/// One deterministic native row: 32 U32 words, then 8 BF16 scales and 8 BF16 biases.
+fn putNativeRow(row: []u8, seed: u64) void {
+    @memset(row, 0);
+    for (0..32) |w| {
+        var word: u32 = 0;
+        for (0..8) |k| {
+            const q: u32 = @intCast((w * 8 + k + seed) % 16);
+            word |= q << @intCast(k * 4);
+        }
+        std.mem.writeInt(u32, row[4 * w ..][0..4], word, .little);
+    }
+    for (0..8) |g| {
+        std.mem.writeInt(u16, row[128 + 2 * g ..][0..2], er.bf16(1.0 + @as(f32, @floatFromInt(g)) * 0.5), .little);
+        std.mem.writeInt(u16, row[144 + 2 * g ..][0..2], er.bf16(-0.5 + @as(f32, @floatFromInt(g)) * 0.125), .little);
+    }
+}
+
+test "a native shard reads rows at the header's 160-byte size" {
+    const a = testing.allocator;
+    const io = testing.io;
+    const rows = 8;
+    const n: usize = @intCast(er.header_bytes + rows * er.native_row_bytes);
+    const b = try a.alloc(u8, n);
+    defer a.free(b);
+    @memset(b, 0);
+    for ([_]u64{ er.magic, 1, 0, rows, rows, er.native_row_bytes }, 0..) |v, i| {
+        std.mem.writeInt(u64, b[8 * i ..][0..8], v, .little);
+    }
+    for (0..rows) |k| putNativeRow(b[er.header_bytes + k * er.native_row_bytes ..][0..er.native_row_bytes], k);
+
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+    try tmp.dir.writeFile(io, .{ .sub_path = "engram-l1-r0of1.bin", .data = b });
+    const root = try tmp.dir.realPathFileAlloc(io, ".", a);
+    defer a.free(root);
+
+    const r = try er.Rows.open(a, root, 0, 1, &.{1}, 4096);
+    defer r.close();
+    try testing.expectEqual(@as(u64, 160), r.tables[0].h.row_bytes);
+
+    const idx = [_]i64{ 7, 0, 3, 0 };
+    const got = try a.alloc(u16, idx.len * er.values);
+    defer a.free(got);
+    try r.rows(0, &idx, er.values, got);
+    for (idx, 0..) |id, i| {
+        var want: [er.values]u16 = undefined;
+        const at: usize = @intCast(er.header_bytes + @as(u64, @intCast(id)) * er.native_row_bytes);
+        try er.decodeRow(b[at..][0..er.native_row_bytes], er.values, null, &want);
+        try testing.expectEqualSlices(u16, &want, got[i * er.values ..][0..er.values]);
+    }
+
+    // a second call served from the cache gives the same bits, and dim is a prefix
+    const again = try a.alloc(u16, 64 * idx.len);
+    defer a.free(again);
+    try r.rows(0, &idx, 64, again);
+    for (idx, 0..) |id, i| {
+        var want: [er.values]u16 = undefined;
+        const at: usize = @intCast(er.header_bytes + @as(u64, @intCast(id)) * er.native_row_bytes);
+        try er.decodeRow(b[at..][0..er.native_row_bytes], er.values, null, &want);
+        try testing.expectEqualSlices(u16, want[0..64], again[i * 64 ..][0..64]);
+    }
+}
