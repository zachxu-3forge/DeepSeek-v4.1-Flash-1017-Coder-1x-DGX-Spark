+                var set = try @import("affine_linears.zig").loadAll(gpa, io, &m.driver, m.stream, &wide, &m.pack, bindings.items);
+                defer set.deinit();
+                if (!quiet) std.log.info("dsv41 affine load: {d} linears packed, {d:.2} GiB", .{ set.items.len, @as(f64, @floatFromInt(set.bytes())) / (1 << 30) });
+            }
             if (try @import("sys").environment.read(bool, "TF_DSV41_AFFINE_SMOKE", false)) {
                 m.weights = .{ .gpa = gpa, .digest = false };
                 defer {
@@ -642,4 +660,5 @@ test {
