diff --git a/zig/src/families/deepseek_v41/affine_linears.zig b/zig/src/families/deepseek_v41/affine_linears.zig
new file mode 100644
index 0000000..ab1a402
--- /dev/null
+++ b/zig/src/families/deepseek_v41/affine_linears.zig
@@ -0,0 +1,99 @@
+//! Every affine linear packed once into `AffineN` tiles, addressable by module name.
+//!
+//! The budget says all linears are ~4.3 GiB packed, so keeping them resident is cheap.
+//! Routed experts are not loaded here: they stay raw and pack one expert at a time.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const Pack = @import("pack.zig").Pack;
+const load = @import("cuda_weights.zig");
+const named = @import("named.zig");
+const affine_load = @import("affine_load.zig");
+const affine_bind = @import("affine_bind.zig");
+const affine_pack = @import("affine_pack.zig");
+const affine_exec = @import("affine_exec.zig");
+
+pub const Item = struct {
+    name: []const u8,
+    tiles: affine_pack.Packed,
+    n: u32,
+    k: u32,
+    bits: u8,
+};
+
+pub const Set = struct {
+    arena: std.heap.ArenaAllocator,
+    items: []Item,
+    map: std.StringHashMapUnmanaged(usize) = .empty,
+
+    pub fn deinit(s: *Set) void {
+        for (s.items) |*item| item.tiles.deinit();
+        s.map.deinit(s.arena.child_allocator);
+        s.arena.deinit();
+        s.* = undefined;
+    }
+
+    pub fn get(s: *const Set, name: []const u8) ?*const Item {
+        const at = s.map.get(name) orelse return null;
+        return &s.items[at];
+    }
+
+    pub fn bytes(s: *const Set) u64 {
+        var total: u64 = 0;
+        for (s.items) |item| {
+            total += item.tiles.words.len + item.tiles.scales.len + item.tiles.biases.len;
+        }
+        return total;
+    }
+};
+
+pub fn loadAll(
+    gpa: std.mem.Allocator,
+    io: std.Io,
+    driver: *const cuda.Driver,
+    stream: cuda.Stream,
+    kernels: *const cuda.qlinear.AffineNKernels,
+    pack: *const Pack,
+    bindings: []const affine_exec.Binding,
+) !Set {
+    var count: usize = 0;
+    for (bindings) |b| {
+        if (b.mode == .affine8_linear and b.affine_layout != null) count += 1;
+    }
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    errdefer arena.deinit();
+    const a = arena.allocator();
+    const items = try gpa.alloc(Item, count);
+    var made: usize = 0;
+    errdefer {
+        for (items[0..made]) |*item| item.tiles.deinit();
+        gpa.free(items);
+    }
+    var map: std.StringHashMapUnmanaged(usize) = .empty;
+    errdefer map.deinit(gpa);
+
+    for (bindings) |b| {
+        if (b.mode != .affine8_linear or b.affine_layout == null) continue;
+        const layout = b.affine_layout.?;
+        var images = try affine_load.readModule(gpa, io, pack, b.name, layout);
+        var builder: named.Builder = .{ .gpa = gpa, .io = io, .pack = pack };
+        defer builder.deinit();
+        try builder.add(images.weight);
+        try builder.add(images.scales);
+        try builder.add(images.biases);
+        images = undefined; // the builder owns the three images
+
+        var weights: load.Weights = .{ .gpa = gpa, .digest = false };
+        defer weights.close() catch {};
+        try weights.upload(driver, &builder);
+        const dev = try affine_bind.bind(&weights, &b, 1);
+        var tiles = try affine_pack.packLinear(driver, stream, kernels, &dev, b.n, b.k, b.spec.bits);
+        errdefer tiles.deinit();
+        const name = try a.dupe(u8, b.name);
+        try map.put(gpa, name, made);
+        items[made] = .{ .name = name, .tiles = tiles, .n = b.n, .k = b.k, .bits = b.spec.bits };
+        made += 1;
+    }
+    if (made != items.len) return error.AffineSetMismatch;
+    return .{ .arena = arena, .items = items, .map = map };
+}
