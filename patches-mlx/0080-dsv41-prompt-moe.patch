+fn ensureMoePf(f: *Forward, r: *run.Runner, n: usize, D: usize, I: usize, slots: usize, experts: usize, need: usize) !*fwd.MoePf {
+    const cap: usize = @max(16, (need + 63) / 64 * 64);
+    if (f.moe_pf) |s| {
+        if (s.rows >= n and s.slots == slots and s.experts >= experts and s.maxm >= cap) return s;
+        s.deinit();
+        f.gpa.destroy(s);
+        f.moe_pf = null;
+    }
+    const maxm = cap;
+    const P = n * slots;
+    const s = try f.gpa.create(fwd.MoePf);
+    errdefer f.gpa.destroy(s);
