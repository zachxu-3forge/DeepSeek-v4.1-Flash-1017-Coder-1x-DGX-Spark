+    errdefer s.xq.free();
+    s.xg = try cuda.DeviceBuffer.alloc(r.d, experts * maxm * D * 2);
+    errdefer s.xg.free();
+    s.gate = try cuda.DeviceBuffer.alloc(r.d, experts * maxm * I * 2);
+    errdefer s.gate.free();
+    s.up = try cuda.DeviceBuffer.alloc(r.d, experts * maxm * I * 2);
