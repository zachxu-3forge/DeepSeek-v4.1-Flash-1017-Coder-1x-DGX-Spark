+/// Decode rows against a resident `AffineN` tile (a pre-packed expert), `x` bf16 `[rows, k]`.
+pub fn tiled(
+    gpa: std.mem.Allocator,
+    driver: *const cuda.Driver,
+    stream: cuda.Stream,
+    kernels: *const cuda.qlinear.AffineNKernels,
+    an: cuda.qlinear.AffineN,
+    x: []const u8,
+    rows: usize,
+) !Output {
+    if (rows == 0 or an.k == 0 or an.n == 0 or an.k % 64 != 0) return error.BadShape;
+    if (x.len != rows * an.k * 2) return error.BadShape;
+    var xb = try cuda.DeviceBuffer.fromHost(driver, x);
+    defer xb.free();
+    const k: usize = an.k;
+    const groups: usize = k / 64;
+    const sums_bytes = try std.math.mul(usize, rows, groups * 4);
+    var sums = try cuda.DeviceBuffer.alloc(driver, sums_bytes);
+    defer sums.free();
+    const host_sums = try gpa.alloc(f32, rows * groups);
+    defer gpa.free(host_sums);
+    for (0..rows) |r| {
+        for (0..groups) |g| {
+            var sum: f32 = 0;
+            for (0..64) |j| {
+                const at = (r * k + g * 64 + j) * 2;
+                sum += named.bf16Widen(std.mem.readInt(u16, x[at..][0..2], .little));
+            }
+            host_sums[r * groups + g] = sum;
+        }
+    }
+    try cuda.DeviceBuffer.upload(.{ .d = driver, .ptr = sums.ptr, .len = sums_bytes }, 0, std.mem.sliceAsBytes(host_sums));
+    var out = try cuda.DeviceBuffer.alloc(driver, rows * an.n * 2);
+    errdefer out.free();
+    try out.fill8(0, null);
+    try kernels.decode(stream, xb.ptr, sums.ptr, an, out.ptr, rows);
+    try stream.synchronize();
+    return .{ .buffer = out };
+}
