+// Grouped 2-bit experts: gather each selected expert's activation rows, one M=count GEMV,
+// then scatter back. The grouped path is used only for rows > 1.
+extern "C" __global__ void __launch_bounds__(256) tf_affine_gather_rows(
+    const __nv_bfloat16* __restrict__ x, const float* __restrict__ xs,
+    const int* __restrict__ members, const int* __restrict__ ucount,
+    int slots, int k, int x_slots, int maxm, __nv_bfloat16* __restrict__ xg,
+    float* __restrict__ xsg, int* __restrict__ slotmap) {
+    const int e = blockIdx.x;
+    if (e >= *ucount) return;
+    int count = 0;
+    while (count < maxm && members[e * maxm + count] >= 0) ++count;
+    for (int r = 0; r < count; ++r) {
+        const int m = members[e * maxm + r];
+        const int i = m / 32, slot = m - i * 32;
+        const int src = x_slots ? i * slots + slot : i;
+        const __nv_bfloat16* srcx = x + (size_t)src * k;
+        __nv_bfloat16* dstx = xg + ((size_t)e * maxm + r) * k;
+        for (int t = threadIdx.x; t < k; t += blockDim.x) dstx[t] = srcx[t];
+        for (int t = threadIdx.x; t < k / 64; t += blockDim.x)
+            xsg[((size_t)e * maxm + r) * (k / 64) + t] = xs[(size_t)src * (k / 64) + t];
+        if (threadIdx.x == 0) slotmap[e * maxm + r] = i * slots + slot;
+    }
+    for (int r = count; r < maxm; ++r) if (threadIdx.x == 0) slotmap[e * maxm + r] = -1;
+}
