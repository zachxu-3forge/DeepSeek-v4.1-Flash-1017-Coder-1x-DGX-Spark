+        const int v = __shfl_up_sync(0xffffffffu, inc, o);
+        if (lane >= o) inc += v;
+    }
+    if (lane == 31) warp_tot[warp] = inc;
+    __syncthreads();
+    if (warp == 0) {
+        const int v = warp_tot[lane];
+        int sum = v;
+#pragma unroll
+        for (int o = 1; o < 32; o <<= 1) {
+            const int x = __shfl_up_sync(0xffffffffu, sum, o);
+            if (lane >= o) sum += x;
+        }
+        warp_tot[lane] = sum - v;
+        if (lane == 31) ucount[0] = sum;
+    }
+    __syncthreads();
+    if (used) {
+        const int p = warp_tot[warp] + inc - used;
+        uids[p] = tid;
+        place[tid] = p;
+    }
+    __syncthreads();
+    if (tid < n) {
+        const int e = picks[tid];
+        if (e >= 0 && e < E) {
+            int rank = 0;
+            for (int q = 0; q < tid; ++q) rank += picks[q] == e;
+            if (rank < maxm) members[(size_t)place[e] * maxm + rank] = (tid / slots) * 32 + tid % slots;
+        }
+    }
+    if (used) for (int j = count[tid]; j < maxm; ++j) members[(size_t)place[tid] * maxm + j] = -1;
