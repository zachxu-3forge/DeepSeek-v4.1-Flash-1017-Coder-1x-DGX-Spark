@@ -0,0 +1,88 @@
+//! The forward dispatch table for affine and mixed DSpark modules.
+//!
+//! The table names the kernel family each module takes: `affine8.cu` for linears, the
+//! per-expert `AffineN` fallback for 2-bit routed experts, and the MXFP8/MXFP4 paths for
+//! DSpark. It is host-only; the forward still has to bind the buffers and launch.
+
+const std = @import("std");
+const affine = @import("affine.zig");
+const plan = @import("affine_plan.zig");
+
+pub const Mode = enum { affine8_linear, affine_n_expert, mxfp8, mxfp4 };
+
+pub const Entry = struct {
+    kind: plan.Kind,
+    name: []const u8,
+    spec: affine.Spec,
+    mode: Mode,
+};
+
+pub const Dispatch = struct {
+    arena: std.heap.ArenaAllocator,
+    entries: []Entry,
+    linear: u32 = 0,
+    expert: u32 = 0,
+    mxfp8: u32 = 0,
+    mxfp4: u32 = 0,
+
+    pub fn deinit(d: *Dispatch) void {
+        d.arena.deinit();
+        d.* = undefined;
+    }
+};
+
+pub fn modeFor(kind: plan.Kind, spec: affine.Spec) !Mode {
+    if (spec.mode == .mxfp8) {
+        if (kind != .linear) return error.BadAffine;
+        return .mxfp8;
+    }
+    if (spec.mode == .mxfp4) {
+        if (kind != .expert) return error.BadAffine;
+        return .mxfp4;
+    }
+    if (spec.mode != .affine) return error.BadAffine;
+    return switch (kind) {
+        .linear => .affine8_linear,
+        .expert => .affine_n_expert,
+    };
+}
+
+pub fn build(gpa: std.mem.Allocator, p: *const plan.Plan) !Dispatch {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    errdefer arena.deinit();
+    const a = arena.allocator();
+    var entries: std.ArrayList(Entry) = .empty;
+    var out: Dispatch = .{ .arena = arena, .entries = &.{} };
+    for (p.layers) |layer| {
+        for (layer.modules) |mod| {
+            const mode = try modeFor(mod.kind, mod.spec);
+            try entries.append(a, .{ .kind = mod.kind, .name = mod.name, .spec = mod.spec, .mode = mode });
+            switch (mode) {
+                .affine8_linear => out.linear += 1,
+                .affine_n_expert => out.expert += 1,
+                .mxfp8 => out.mxfp8 += 1,
+                .mxfp4 => out.mxfp4 += 1,
+            }
+        }
+    }
+    for (p.mixed) |mod| {
+        const mode = try modeFor(mod.kind, mod.spec);
+        try entries.append(a, .{ .kind = mod.kind, .name = mod.name, .spec = mod.spec, .mode = mode });
+        switch (mode) {
+            .affine8_linear => out.linear += 1,
+            .affine_n_expert => out.expert += 1,
+            .mxfp8 => out.mxfp8 += 1,
+            .mxfp4 => out.mxfp4 += 1,
+        }
+    }
+    out.entries = try entries.toOwnedSlice(a);
+    return out;
+}
+
+test "dispatch maps linears, 2-bit experts, and mixed DSpark" {
+    try std.testing.expectEqual(Mode.affine8_linear, try modeFor(.linear, .{ .bits = 6, .group = 64 }));
+    try std.testing.expectEqual(Mode.affine_n_expert, try modeFor(.expert, .{ .bits = 2, .group = 64 }));
+    try std.testing.expectEqual(Mode.mxfp8, try modeFor(.linear, .{ .bits = 8, .mode = .mxfp8 }));
+    try std.testing.expectEqual(Mode.mxfp4, try modeFor(.expert, .{ .bits = 4, .mode = .mxfp4 }));
+    try std.testing.expectError(error.BadAffine, modeFor(.linear, .{ .bits = 4, .group = 64, .mode = .mxfp4 }));
+}
