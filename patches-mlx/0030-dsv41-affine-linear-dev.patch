+/// Decode device rows: `x` is a device bf16 `[rows, k]`, `out` a device bf16
+/// `[rows, n]`. The group sums are computed on the device; the caller synchronizes.
+pub fn linearDev(
+    driver: *const cuda.Driver,
+    stream: cuda.Stream,
+    kernels: *const cuda.qlinear.AffineNKernels,
+    act: *const cuda.act_rows.ActRows,
+    p: *const pack.Packed,
+    x: u64,
+    rows: usize,
+    out: u64,
+) !void {
+    if (rows == 0 or p.an.k == 0 or p.an.k % 64 != 0) return error.BadShape;
+    const groups = p.an.k / 64;
+    const sums_bytes = try std.math.mul(usize, rows, groups * 4);
+    var sums = try cuda.DeviceBuffer.alloc(driver, sums_bytes);
+    defer sums.free();
+    try act.groupSums(stream, x, p.an.k, sums.ptr, rows, p.an.k);
+    try kernels.decode(stream, x, sums.ptr, p.an, out, rows);
+}
+
