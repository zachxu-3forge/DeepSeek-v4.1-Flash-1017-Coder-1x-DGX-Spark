+    try testing.expectEqual(@as(usize, 0), l.experts[0].parts.len);
+    var has_wo_a = false;
+    var has_gate = false;
+    for (l.natives) |v| {
+        if (std.mem.endsWith(u8, v.name, ".attn.wo_a.weight")) has_wo_a = true;
+        if (std.mem.endsWith(u8, v.name, ".ffn.gate.weight")) has_gate = true;
+    }
+    try testing.expect(has_wo_a and has_gate);
+    try testing.expectEqual(@as(usize, 3), d.top.len); // embed, norm, head
+    try testing.expect(std.mem.endsWith(u8, d.top[2].name, "head.weight"));
+    try testing.expectEqual(@as(usize, 0), d.leftovers.len);
+}
