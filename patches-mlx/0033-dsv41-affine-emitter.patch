diff --git a/zig/src/families/deepseek_v41/affine_runtime.zig b/zig/src/families/deepseek_v41/affine_runtime.zig
new file mode 100644
index 0000000..13666dc
--- /dev/null
+++ b/zig/src/families/deepseek_v41/affine_runtime.zig
@@ -0,0 +1,87 @@
+//! The affine model's resident kernels: `affine8` / `affine_prefill` / `affine4_pack`,
+//! `act_rows`, and every dense affine linear packed once into `AffineN` tiles.
+//!
+//! The forward emits `tf_dsv41_affine_v1.linear` calls; `kernels_replay.zig` resolves
+//! their name hash here and launches decode (`rows <= 16`) or prompt rows.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const Pack = @import("pack.zig").Pack;
+const exec = @import("affine_exec.zig");
+const linears = @import("affine_linears.zig");
+
+pub const Affine = struct {
+    mods: [3]cuda.Module,
+    wide: cuda.qlinear.AffineNKernels,
+    act: cuda.act_rows.ActRows,
+    linears: linears.Set,
+
+    /// Loads the affine CUDA kernels and packs every affine linear in `bindings`.
+    pub fn load(
+        gpa: std.mem.Allocator,
+        io: std.Io,
+        d: *const cuda.Driver,
+        stream: cuda.Stream,
+        pack: *const Pack,
+        bindings: []const exec.Binding,
+        sms: usize,
+        gb10: bool,
+    ) !Affine {
+        var a: Affine = undefined;
+        a.mods[0] = try cuda.Module.load(d, cuda.kernels.affine8);
+        errdefer a.mods[0].unload();
+        a.mods[1] = try cuda.Module.load(d, cuda.kernels.affine_prefill);
+        errdefer a.mods[1].unload();
+        a.mods[2] = try cuda.Module.load(d, cuda.kernels.affine4_pack);
+        errdefer a.mods[2].unload();
+        a.wide = try cuda.qlinear.AffineNKernels.resolve(d, a.mods[0], a.mods[1], a.mods[2], sms, gb10);
+        errdefer a.wide.deinit();
+        a.act = try cuda.act_rows.ActRows.load(d);
+        errdefer a.act.unload();
+        a.linears = try linears.loadAll(gpa, io, d, stream, &a.wide, pack, bindings);
+        return a;
+    }
+
+    pub fn deinit(a: *Affine) void {
+        a.linears.deinit();
+        a.act.unload();
+        a.wide.deinit();
+        a.mods[2].unload();
+        a.mods[1].unload();
+        a.mods[0].unload();
+        a.* = undefined;
+    }
+
+    pub fn bytes(a: *const Affine) u64 {
+        return a.linears.bytes();
+    }
+
+    /// One affine projection: `x` device bf16 [rows, k], `y` device bf16 [rows, n].
+    /// Decode rows (<= 16) take the group sums kernel; wider windows use the prompt GEMM.
+    pub fn linear(
+        a: *const Affine,
+        stream: cuda.Stream,
+        sums: u64,
+        id: u64,
+        x: u64,
+        y: u64,
+        rows: usize,
+        k: usize,
+        n: usize,
+    ) !void {
+        const item = a.linears.getHashed(id) orelse return error.UnknownAffine;
+        if (item.k != k or item.n != n or rows == 0 or k % 64 != 0) return error.BadShape;
+        if (rows <= 16) {
+            if (sums == 0) return error.BadShape;
+            try a.act.groupSums(stream, x, k, sums, rows, k);
+            try a.wide.decode(stream, x, sums, item.tiles.an, y, rows);
+        } else try a.wide.prompt(stream, x, item.tiles.an, y, rows);
+    }
+};
+
+test "an affine name hash is stable and fits a call's integer argument" {
+    const h = linears.nameHash("layers.0.attn.wq_a");
+    try std.testing.expectEqual(h, linears.nameHash("layers.0.attn.wq_a"));
+    try std.testing.expect(h != linears.nameHash("layers.0.attn.wq_b"));
+    try std.testing.expect(h <= std.math.maxInt(i64));
+}
