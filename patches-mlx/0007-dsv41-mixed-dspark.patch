+test "MTP MXFP8 and MXFP4 modules are listed as mixed, not affine" {
+    const a = std.testing.allocator;
+    var cfg = @import("config.zig").tiny();
+    cfg.layers = 1;
+    cfg.mtp_layers = 1;
+    cfg.q_lora = 64;
+    cfg.compress_ratios = @import("config.zig").Ids.of(&.{0});
+    cfg.kv_sources = .{};
+    cfg.index_sources = .{};
+    cfg.engram_layers = .{};
+    cfg.engram_rows = @import("config.zig").List(u64, 8).of(&.{});
+    const json =
+        \\{"quantization":{"quant_method":"affine","bits":4,"group_size":64,"dense_by_default":true,
+        \\"mtp.0.attn.wq_a":{"bits":8,"mode":"mxfp8"},
+        \\"mtp.0.ffn.experts.w1":{"bits":4,"mode":"mxfp4"}}}
+    ;
+    var formats = try affine.Formats.init(a, json);
+    defer formats.deinit();
+    var p = Pack.init(a);
+    defer p.deinit();
+    var plan = try build(a, &cfg, &p, &formats);
+    defer plan.deinit();
+    try std.testing.expectEqual(@as(usize, 2), plan.mixed.len);
+    try std.testing.expectEqual(affine.Mode.mxfp8, plan.mixed[0].spec.mode);
+    try std.testing.expectEqual(Kind.linear, plan.mixed[0].kind);
+    try std.testing.expectEqual(affine.Mode.mxfp4, plan.mixed[1].spec.mode);
+    try std.testing.expectEqual(Kind.expert, plan.mixed[1].kind);
+}
