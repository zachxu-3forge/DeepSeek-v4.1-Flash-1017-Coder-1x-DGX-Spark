+// wo_a's eight block-diagonal groups in one launch: out[r, g*ol+j] = sum_k x[r, g*gk+k] * w[g*ol+j, k].
+// One warp an output, the block's input row in shared memory; fp32 accumulation, bf16 result.
+extern "C" __global__ void __launch_bounds__(128) dsv41_woa_groups(const uint16_t* __restrict__ x, int nrows,
+                                                                  const uint16_t* __restrict__ w,
+                                                                  uint16_t* __restrict__ out,
+                                                                  int g, int gk, int ol) {
+    __shared__ uint16_t xs[4096];
+    const int per = 4;                  // outputs a block
+    const int tiles = ol / per;
+    const int grp = blockIdx.x / tiles;
+    const int tile = blockIdx.x - grp * tiles;
+    const int warp = threadIdx.x >> 5;
+    const int lane = threadIdx.x & 31;
+    const int j = tile * per + warp;
+    const int r = blockIdx.y;
+    const uint16_t* xr = x + ((long long)r * g + grp) * gk;
+    const uint16_t* wr = w + ((long long)grp * ol + j) * gk;
+    for (int k = threadIdx.x; k < gk; k += blockDim.x) xs[k] = xr[k];
+    __syncthreads();
+    float acc = 0.0f;
+    for (int k = lane; k < gk; k += 32) acc += bf(xs[k]) * bf(wr[k]);
+    for (int off = 16; off > 0; off >>= 1) acc += __shfl_down_sync(0xffffffffu, acc, off);
+    if (lane == 0) out[(long long)r * g * ol + grp * ol + j] = to_bf(acc);
+}
