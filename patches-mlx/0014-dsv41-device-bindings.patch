diff --git a/zig/src/families/deepseek_v41/affine_bind.zig b/zig/src/families/deepseek_v41/affine_bind.zig
new file mode 100644
index 0000000..362d271
--- /dev/null
+++ b/zig/src/families/deepseek_v41/affine_bind.zig
@@ -0,0 +1,133 @@
+//! Bind a dispatch entry's host layouts to the loaded device tensors.
+//!
+//! The caller supplies a map with `get(name) ?{ ptr, len }` (the engine's `Weights`);
+//! this module checks the byte sizes and freezes the addresses/offsets the launch uses.
+//! It does not allocate or launch.
+
+const std = @import("std");
+const affine = @import("affine.zig");
+const mixed = @import("mixed.zig");
+const plan = @import("affine_plan.zig");
+const dispatch = @import("affine_dispatch.zig");
+const exec = @import("affine_exec.zig");
+
+pub const Device = struct {
+    kind: plan.Kind,
+    name: []const u8,
+    mode: dispatch.Mode,
+    weight: u64,
+    weight_len: usize,
+    scales: u64,
+    scales_len: usize,
+    biases: u64 = 0,
+    biases_len: usize = 0,
+    experts: u32 = 1,
+    bits: u8,
+    group: u32,
+};
+
+fn need(map: anytype, name: []const u8) !@TypeOf(map.get(name).?) {
+    return map.get(name) orelse return error.MissingWeight;
+}
+
+pub fn bind(map: anytype, b: *const exec.Binding, experts: u32) !Device {
+    var name_buf: [256]u8 = undefined;
+    const wname = try std.fmt.bufPrint(&name_buf, "{s}.weight", .{b.name});
+    const weight = try need(map, wname);
+    const sname = try std.fmt.bufPrint(&name_buf, "{s}.scales", .{b.name});
+    const scales = try need(map, sname);
+
+    var out: Device = .{
+        .kind = b.kind,
+        .name = b.name,
+        .mode = b.mode,
+        .weight = weight.ptr,
+        .weight_len = weight.len,
+        .scales = scales.ptr,
+        .scales_len = scales.len,
+        .experts = if (b.kind == .expert) experts else 1,
+        .bits = b.spec.bits,
+        .group = b.spec.group,
+    };
+
+    switch (b.mode) {
+        .affine8_linear, .affine_n_expert => {
+            const layout = b.affine_layout orelse return error.BadBinding;
+            const packed_k = try layout.packedK();
+            const groups = try layout.groups();
+            const rows = std.math.mul(u64, out.experts, b.n) catch return error.BadBinding;
+            const wbytes = std.math.mul(u64, rows, std.math.mul(u64, packed_k, 4) catch return error.BadBinding) catch return error.BadBinding;
+            const sbytes = std.math.mul(u64, rows, std.math.mul(u64, groups, 2) catch return error.BadBinding) catch return error.BadBinding;
+            if (@as(u64, weight.len) != wbytes or @as(u64, scales.len) != sbytes) return error.BadSize;
+            const bname = try std.fmt.bufPrint(&name_buf, "{s}.biases", .{b.name});
+            const biases = try need(map, bname);
+            if (@as(u64, biases.len) != sbytes) return error.BadSize;
+            out.biases = biases.ptr;
+            out.biases_len = biases.len;
+        },
+        .mxfp8, .mxfp4 => {
+            const layout = b.mixed_layout orelse return error.BadBinding;
+            const packed_k = try layout.packedK();
+            const groups = try layout.groups();
+            const rows = std.math.mul(u64, out.experts, b.n) catch return error.BadBinding;
+            const wbytes = std.math.mul(u64, rows, std.math.mul(u64, packed_k, 4) catch return error.BadBinding) catch return error.BadBinding;
+            const sbytes = std.math.mul(u64, rows, groups) catch return error.BadBinding;
+            if (@as(u64, weight.len) != wbytes or @as(u64, scales.len) != sbytes) return error.BadSize;
+        },
+    }
+    return out;
+}
+
+const testing = std.testing;
+
+const T = struct { ptr: u64, len: usize };
+const Entry = struct { name: []const u8, t: T };
+
+fn fakeGet(name: []const u8, entries: []const Entry) ?T {
+    for (entries) |e| if (std.mem.eql(u8, e.name, name)) return e.t;
+    return null;
+}
+
+test "affine expert and mixed bindings check byte sizes" {
+    const expert_entries = [_]Entry{
+        .{ .name = "e.weight", .t = .{ .ptr = 0x1000, .len = 96 } },
+        .{ .name = "e.scales", .t = .{ .ptr = 0x2000, .len = 12 } },
+        .{ .name = "e.biases", .t = .{ .ptr = 0x3000, .len = 12 } },
+    };
+    const Fake = struct {
+        entries: []const Entry,
+        fn get(self: @This(), name: []const u8) ?T {
+            return fakeGet(name, self.entries);
+        }
+    };
+    const e: exec.Binding = .{
+        .kind = .expert,
+        .name = "e",
+        .spec = .{ .bits = 2, .group = 64 },
+        .mode = .affine_n_expert,
+        .n = 3,
+        .k = 64,
+        .affine_layout = .{ .n = 3, .k = 64, .bits = 2, .group = 64 },
+    };
+    const d = try bind(Fake{ .entries = &expert_entries }, &e, 2);
+    try testing.expectEqual(@as(u64, 0x1000), d.weight);
+    try testing.expectEqual(@as(u64, 0x3000), d.biases);
+    try testing.expectEqual(@as(u32, 2), d.experts);
+
+    const mixed_entries = [_]Entry{
+        .{ .name = "m.weight", .t = .{ .ptr = 0x4000, .len = 384 } },
+        .{ .name = "m.scales", .t = .{ .ptr = 0x5000, .len = 12 } },
+    };
+    const m: exec.Binding = .{
+        .kind = .linear,
+        .name = "m",
+        .spec = .{ .bits = 8, .mode = .mxfp8 },
+        .mode = .mxfp8,
+        .n = 3,
+        .k = 128,
+        .mixed_layout = .{ .n = 3, .k = 128, .bits = 8 },
+    };
+    const dm = try bind(Fake{ .entries = &mixed_entries }, &m, 1);
+    try testing.expectEqual(@as(u64, 0x4000), dm.weight);
+    try testing.expectEqual(@as(u64, 0), dm.biases);
+}
