diff --git a/zig/src/families/deepseek_v41/affine_exec.zig b/zig/src/families/deepseek_v41/affine_exec.zig
new file mode 100644
index 0000000..6010812
--- /dev/null
+++ b/zig/src/families/deepseek_v41/affine_exec.zig
@@ -0,0 +1,75 @@
+//! Host-side bindings for the forward dispatch table.
+//!
+//! Each dispatch entry becomes the layout the launcher needs: an affine layout for
+//! `affine8.cu` linears and the per-expert fallback, or a mixed layout for MXFP8/MXFP4.
+//! Device buffers are bound later; this module only freezes shapes and formats.
+
+const std = @import("std");
+const affine = @import("affine.zig");
+const mixed = @import("mixed.zig");
+const plan = @import("affine_plan.zig");
+const dispatch = @import("affine_dispatch.zig");
+
+pub const Binding = struct {
+    kind: plan.Kind,
+    name: []const u8,
+    spec: affine.Spec,
+    mode: dispatch.Mode,
+    n: u32,
+    k: u32,
+    affine_layout: ?affine.Layout = null,
+    mixed_layout: ?mixed.Layout = null,
+};
+
+pub const Bindings = struct {
+    arena: std.heap.ArenaAllocator,
+    items: []Binding,
+
+    pub fn deinit(b: *Bindings) void {
+        b.arena.deinit();
+        b.* = undefined;
+    }
+};
+
+pub fn build(gpa: std.mem.Allocator, d: *const dispatch.Dispatch) !Bindings {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    errdefer arena.deinit();
+    const a = arena.allocator();
+    const items = try a.alloc(Binding, d.entries.len);
+    for (d.entries, items) |e, *b| {
+        b.* = .{
+            .kind = e.kind,
+            .name = e.name,
+            .spec = e.spec,
+            .mode = e.mode,
+            .n = e.n,
+            .k = e.k,
+        };
+        switch (e.mode) {
+            .affine8_linear, .affine_n_expert => {
+                b.affine_layout = .{ .n = e.n, .k = e.k, .bits = e.spec.bits, .group = e.spec.group };
+            },
+            .mxfp8, .mxfp4 => {
+                b.mixed_layout = .{ .n = e.n, .k = e.k, .bits = e.spec.bits };
+            },
+        }
+    }
+    return .{ .arena = arena, .items = items };
+}
+
+test "bindings freeze affine and mixed layouts" {
+    const a = std.testing.allocator;
+    var entries = [_]dispatch.Entry{
+        .{ .kind = .linear, .name = "layers.0.attn.wq_a", .spec = .{ .bits = 6, .group = 64 }, .mode = .affine8_linear, .n = 1280, .k = 5120 },
+        .{ .kind = .expert, .name = "layers.0.ffn.experts.w1", .spec = .{ .bits = 2, .group = 64 }, .mode = .affine_n_expert, .n = 2304, .k = 5120 },
+        .{ .kind = .linear, .name = "mtp.0.attn.wq_a", .spec = .{ .bits = 8, .mode = .mxfp8 }, .mode = .mxfp8, .n = 1280, .k = 5120 },
+    };
+    var d: dispatch.Dispatch = .{ .arena = std.heap.ArenaAllocator.init(a), .entries = &entries };
+    defer d.deinit();
+    var b = try build(a, &d);
+    defer b.deinit();
+    try std.testing.expectEqual(@as(usize, 3), b.items.len);
+    try std.testing.expectEqual(@as(u32, 64), b.items[0].affine_layout.?.group);
+    try std.testing.expectEqual(@as(u32, 2), b.items[1].affine_layout.?.bits);
+    try std.testing.expectEqual(@as(u8, 8), b.items[2].mixed_layout.?.bits);
+}
