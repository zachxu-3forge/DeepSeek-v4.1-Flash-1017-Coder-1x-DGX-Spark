+// The clamped SwiGLU's fp32 product is this close to a bf16 midpoint; recompute exp in double there,
+// as act_rows.cu's swiglu does, so the bf16 row is the host's.
+__device__ __forceinline__ bool gu_near_bf16_mid(float y) {
+    const uint32_t bits = __float_as_uint(y);
+    if ((bits & 0x7f800000u) == 0x7f800000u) return false;
+    const uint32_t low = bits & 0xffffu;
+    const uint32_t d = low >= 0x8000u ? low - 0x8000u : 0x8000u - low;
+    const uint32_t wrap = 0x10000u - d;
+    return d < 32u || wrap < 32u;
+}
+
+__device__ __forceinline__ float gu_swiglu_one(float g, float u, float limit, bool exact) {
+    const float a = fminf(g, limit);
+    const float ef = exact ? static_cast<float>(exp(static_cast<double>(-a))) : expf(-a);
+    const float s = __fdiv_rn(a, __fadd_rn(1.0f, ef));
+    return __fmul_rn(s, fminf(fmaxf(u, -limit), limit));
+}
