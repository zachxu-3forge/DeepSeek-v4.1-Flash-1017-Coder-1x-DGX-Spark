+/// A translated omlx map: a global affine fallback and per-module overrides, with non-affine
+/// DSpark modules listed separately (MXFP8 and MXFP4).
+fn requireAffine(quant: std.json.ObjectMap) !void {
+    const bits = quant.get("bits") orelse return error.MissingField;
+    const group = quant.get("group_size") orelse return error.MissingField;
+    const b = unsigned(u64, bits) catch return error.BadConfig;
+    const g = unsigned(u64, group) catch return error.BadConfig;
+    if (std.mem.indexOfScalar(u64, &.{ 2, 3, 4, 5, 6, 8 }, b) == null) return error.BadConfig;
+    if (std.mem.indexOfScalar(u64, &.{ 32, 64, 128 }, g) == null) return error.BadConfig;
+    if (quant.get("mode")) |mode| {
+        if (mode != .string or !std.mem.eql(u8, mode.string, "affine")) return error.BadConfig;
+    }
+    if (quant.get("non_affine_modules")) |v| {
+        if (v != .object) return error.BadConfig;
+        var it = v.object.iterator();
+        while (it.next()) |entry| {
+            const spec = entry.value_ptr.*;
+            if (spec != .object) return error.BadConfig;
+            const mode = spec.object.get("mode") orelse return error.BadConfig;
+            if (mode != .string or
+                !(std.mem.eql(u8, mode.string, "mxfp8") or std.mem.eql(u8, mode.string, "mxfp4")))
+                return error.BadConfig;
+        }
+    }
+}
+
