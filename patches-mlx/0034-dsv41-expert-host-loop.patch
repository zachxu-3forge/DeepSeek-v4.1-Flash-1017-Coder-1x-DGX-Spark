+    for (0..n) |i| {
+        const row = xb[i * D * 2 ..][0 .. D * 2];
+        for (0..topk) |j| {
+            const e = std.mem.readInt(i32, pb[(i * slots + j) * 4 ..][0..4], .little);
+            if (e < 0) continue;
+            const w: f32 = @bitCast(std.mem.readInt(u32, wb[(i * slots + j) * 4 ..][0..4], .little));
+            if (w == 0) continue;
+            const y1 = try af.expertHost(f.gpa, r.d, r.stream, w1n, @intCast(e), row, 1);
+            defer f.gpa.free(y1);
+            const y3 = try af.expertHost(f.gpa, r.d, r.stream, w3n, @intCast(e), row, 1);
+            defer f.gpa.free(y3);
+            const act = try f.gpa.alloc(u8, I * 2);
+            defer f.gpa.free(act);
+            try swigluRow(y1, y3, act, limit);
+            const y2 = try af.expertHost(f.gpa, r.d, r.stream, w2n, @intCast(e), act, 1);
+            defer f.gpa.free(y2);
+            for (0..D) |d| acc[i * D + d] += w * named.bf16Widen(std.mem.readInt(u16, y2[2 * d ..][0..2], .little));
+        }
+    }
+
+    if (out.dt == .bf16) {
+        const half = try f.gpa.alloc(u8, n * D * 2);
+        defer f.gpa.free(half);
+        for (acc, 0..) |v, i| std.mem.writeInt(u16, half[2 * i ..][0..2], named.bf16Round(v), .little);
+        try cuda.DeviceBuffer.upload(.{ .d = r.d, .ptr = try r.tensorAddr(out), .len = half.len }, 0, half);
+    } else try cuda.DeviceBuffer.upload(.{ .d = r.d, .ptr = try r.tensorAddr(out), .len = std.mem.sliceAsBytes(acc).len }, 0, std.mem.sliceAsBytes(acc));
+}
+
+fn swigluRow(gate: []const u8, up: []const u8, out: []u8, limit: f32) !void {
+    if (gate.len != up.len or out.len != gate.len) return error.BadGlue;
+    for (0..gate.len / 2) |i| {
+        const g = named.bf16Widen(std.mem.readInt(u16, gate[2 * i ..][0..2], .little));
+        const u = named.bf16Widen(std.mem.readInt(u16, up[2 * i ..][0..2], .little));
+        // pointwise.cu: silu(min(g, limit)) * clamp(u, -limit, limit)
+        const a = @min(g, limit);
+        const v = (a / (1 + @exp(-a))) * std.math.clamp(u, -limit, limit);
+        std.mem.writeInt(u16, out[2 * i ..][0..2], named.bf16Round(v), .little);
+    }
+}
+
+test "the affine MoE host activation matches pointwise.cu's clamp" {
+    var gate: [8]u8 = undefined;
+    var up: [8]u8 = undefined;
+    var out: [8]u8 = undefined;
+    const gs = [_]f32{ 20.0, 1.0, -20.0, 0.0 };
+    const us = [_]f32{ 2.0, 20.0, 2.0, -20.0 };
+    for (gs, us, 0..) |g, u, i| {
+        std.mem.writeInt(u16, gate[2 * i ..][0..2], named.bf16Round(g), .little);
+        std.mem.writeInt(u16, up[2 * i ..][0..2], named.bf16Round(u), .little);
+    }
+    try swigluRow(&gate, &up, &out, 10.0);
+    for (gs, us, 0..) |g, u, i| {
+        const a = @min(g, 10.0);
+        const want = (a / (1 + @exp(-a))) * std.math.clamp(u, -10.0, 10.0);
+        const got = named.bf16Widen(std.mem.readInt(u16, out[2 * i ..][0..2], .little));
+        try std.testing.expectApproxEqAbs(want, got, 0.02);
+    }
+}
