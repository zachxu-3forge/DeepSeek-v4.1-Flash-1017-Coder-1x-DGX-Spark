+// The dense head: 32 vocabulary columns a block, 8 lanes an output, bf16 weights in the
+// existing [n, k] layout, fp32 accumulation, fp32 logits. (The old _plain used fp64 sums.)
+extern "C" __global__ void __launch_bounds__(256) dsv41_head_gemv(const uint16_t* __restrict__ x,
+                                                                  const uint16_t* __restrict__ w,
+                                                                  float* __restrict__ out,
+                                                                  int rows, int k, int n) {
+    __shared__ __align__(16) uint16_t xs[5120];
+    const int r = blockIdx.y;
+    const uint16_t* xrow = x + (long long)r * k;
+    for (int t = threadIdx.x; t < k; t += blockDim.x) xs[t] = xrow[t];
+    __syncthreads();
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    const int sub = lane >> 3, sl = lane & 7;
+    const int j = blockIdx.x * 32 + warp * 4 + sub;
+    if (j >= n) return;
+    const uint16_t* wr = w + (long long)j * k;
+    float acc = 0.0f;
+    for (int base = sl * 8; base < k; base += 64) {
+        const uint4 xv = *reinterpret_cast<const uint4*>(xs + base);
+        const uint4 wv = *reinterpret_cast<const uint4*>(wr + base);
+        const uint16_t* xp = reinterpret_cast<const uint16_t*>(&xv);
+        const uint16_t* wp = reinterpret_cast<const uint16_t*>(&wv);
+#pragma unroll
+        for (int i = 0; i < 8; ++i) acc += bf(xp[i]) * bf(wp[i]);
+    }
+#pragma unroll
+    for (int off = 4; off > 0; off >>= 1) acc += __shfl_down_sync(0xffffffffu, acc, off, 8);
+    if (sl == 0) out[(long long)r * n + j] = acc;
+}
