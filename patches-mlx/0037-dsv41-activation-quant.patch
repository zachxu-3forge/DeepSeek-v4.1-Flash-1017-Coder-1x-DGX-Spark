diff --git a/zig/src/families/deepseek_v41/act_quant.zig b/zig/src/families/deepseek_v41/act_quant.zig
new file mode 100644
index 0000000..8febffe
--- /dev/null
+++ b/zig/src/families/deepseek_v41/act_quant.zig
@@ -0,0 +1,92 @@
+//! omlx's activation quantization: FP8 E4M3, one power-of-two scale per 32
+//! inputs, quantized and immediately dequantized back to bf16.
+//!
+//! This is the `quantize_activation(x)` step every `QuantizedProjection` with
+//! `quantize_input` applies before its affine matmul. It is a numerical
+//! round-trip, not a packed activation format.
+
+const std = @import("std");
+const named = @import("named.zig");
+
+/// Round one positive f32 to the E4M3 grid, nearest-even, saturating at 448.
+fn roundFp8Positive(a_in: f32) f32 {
+    const a = @min(a_in, 448.0);
+    if (a == 0 or a != a) return a;
+    const bits: u32 = @bitCast(a);
+    const e: i32 = @as(i32, @intCast((bits >> 23) & 0xff)) - 127;
+    const step_exp: i32 = @max(e - 3, -9);
+    const step: f32 = @bitCast(@as(u32, @intCast(step_exp + 127)) << 23);
+    const q = a / step;
+    const floor = @floor(q);
+    const frac = q - floor;
+    const rounded = if (frac > 0.5 or (frac == 0.5 and @mod(floor, 2.0) != 0)) floor + 1 else floor;
+    return @min(rounded * step, 448.0);
+}
+
+/// The E4M3FN value nearest `x`, with the original's sign and finite saturation.
+pub fn roundFp8(x: f32) f32 {
+    if (x != x) return x;
+    const neg = (@as(u32, @bitCast(x)) & 0x8000_0000) != 0;
+    const r = roundFp8Positive(@abs(x));
+    return if (neg) -r else r;
+}
+
+/// The original's `fast_round_scale`: 2^ceil(log2(amax / 448)) from the product's
+/// IEEE bits, so the scale is a normal power of two.
+fn scaleFor(amax_in: f32) f32 {
+    const amax = @max(amax_in, 1e-4);
+    const v = amax * (1.0 / 448.0);
+    const bits: u32 = @bitCast(v);
+    const e: i32 = @as(i32, @intCast((bits >> 23) & 0xff)) - 127 + @intFromBool((bits & 0x7f_ffff) != 0);
+    return @bitCast(@as(u32, @intCast(e + 127)) << 23);
+}
+
+/// Quantize/dequantize one bf16 row of `k` values in place of the source.
+/// `k` must be a multiple of 32.
+pub fn quantizeRow(src: []const u8, dst: []u8, k: usize) !void {
+    if (k == 0 or k % 32 != 0 or src.len != k * 2 or dst.len != k * 2) return error.BadShape;
+    var g: usize = 0;
+    while (g < k) : (g += 32) {
+        var amax: f32 = 0;
+        for (0..32) |j| {
+            const at = (g + j) * 2;
+            const v = named.bf16Widen(std.mem.readInt(u16, src[at..][0..2], .little));
+            amax = @max(amax, @abs(v));
+        }
+        const scale = scaleFor(amax);
+        for (0..32) |j| {
+            const at = (g + j) * 2;
+            const v = named.bf16Widen(std.mem.readInt(u16, src[at..][0..2], .little));
+            const q = roundFp8(std.math.clamp(v / scale, -448.0, 448.0));
+            std.mem.writeInt(u16, dst[at..][0..2], named.bf16Round(q * scale), .little);
+        }
+    }
+}
+
+test "FP8 activation round-trip keeps values on the E4M3 grid" {
+    var src: [64]u8 = undefined;
+    var dst: [64]u8 = undefined;
+    const values = [_]f32{ 1.0, -1.0, 0.5, -0.5, 0.0, 1e-4, 448.0, -448.0 };
+    for (values, 0..) |v, i| {
+        std.mem.writeInt(u16, src[2 * i ..][0..2], named.bf16Round(v), .little);
+    }
+    // Fill the group so the scale is the group's max.
+    for (values.len..32) |i| {
+        std.mem.writeInt(u16, src[2 * i ..][0..2], named.bf16Round(1.0), .little);
+    }
+    try quantizeRow(src[0..64], dst[0..64], 32);
+    try std.testing.expectEqual(@as(f32, 1.0), named.bf16Widen(std.mem.readInt(u16, dst[0..2], .little)));
+    try std.testing.expectEqual(@as(f32, -1.0), named.bf16Widen(std.mem.readInt(u16, dst[2..4], .little)));
+    try std.testing.expectEqual(@as(f32, 0.5), named.bf16Widen(std.mem.readInt(u16, dst[4..6], .little)));
+    try std.testing.expectEqual(@as(f32, -0.5), named.bf16Widen(std.mem.readInt(u16, dst[6..8], .little)));
+}
+
+test "FP8 activation quantization is a no-op for a constant exact group" {
+    var src: [64]u8 = undefined;
+    var dst: [64]u8 = undefined;
+    for (0..32) |i| std.mem.writeInt(u16, src[2 * i ..][0..2], named.bf16Round(0.5), .little);
+    try quantizeRow(src[0..64], dst[0..64], 32);
+    for (0..32) |i| {
+        try std.testing.expectEqual(@as(f32, 0.5), named.bf16Widen(std.mem.readInt(u16, dst[2 * i ..][0..2], .little)));
+    }
+}
