+// omlx's quantize_activation: FP8 E4M3, a power-of-two scale a 32 values, dequantized to bf16.
+__device__ __forceinline__ float tf_round_fp8(float x) {
+    const uint32_t bits = __float_as_uint(x);
+    const bool neg = (bits >> 31) != 0;
+    const float a = fminf(fabsf(x), 448.0f);
+    if (a == 0.0f || a != a) return x;
+    const int e = static_cast<int>((__float_as_uint(a) >> 23) & 0xffu) - 127;
+    const int se = e - 3 > -9 ? e - 3 : -9;
+    const float step = __int_as_float(static_cast<uint32_t>(se + 127) << 23);
+    const float q = a / step;
+    const float v = fminf(rintf(q) * step, 448.0f);
+    return neg ? -v : v;
+}
+
+// out[r, i] = bf16(round_fp8(x[r * ld + i] / scale) * scale), one scale a 32 values (k % 32 == 0).
+extern "C" __global__ void __launch_bounds__(NT) tf_quant_fp8_rows(const __nv_bfloat16* __restrict__ x, long long ld,
+                                                                   __nv_bfloat16* __restrict__ out, int k) {
+    const int64_t r = blockIdx.x;
+    const int c = blockIdx.y * blockDim.x + threadIdx.x; // 8 values, 4 threads a 32-value group
+    const bool live = 8 * c < k;
+    float v[8];
+    if (live) {
+        unpack8(*reinterpret_cast<const uint4*>(x + r * ld + 8 * c), v);
+    } else {
+#pragma unroll
+        for (int i = 0; i < 8; ++i) v[i] = 0.f;
+    }
+    float amax = 0.f;
+#pragma unroll
+    for (int i = 0; i < 8; ++i) amax = fmaxf(amax, fabsf(v[i]));
+    amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, 1));
+    amax = fmaxf(amax, __shfl_xor_sync(0xffffffffu, amax, 2));
+    amax = fmaxf(amax, 1e-4f);
+    const uint32_t sb = __float_as_uint(amax * (1.0f / 448.0f));
+    const int se = static_cast<int>((sb >> 23) & 0xffu) - 127 + ((sb & 0x7fffffu) != 0);
+    const float scale = __int_as_float(static_cast<uint32_t>(se + 127) << 23);
+#pragma unroll
+    for (int i = 0; i < 8; ++i)
+        v[i] = tf_round_fp8(fminf(fmaxf(v[i] / scale, -448.f), 448.f)) * scale;
+    if (live) *reinterpret_cast<uint4*>(out + r * k + 8 * c) = pack8(v);
+}
